# =============================================================================
# AcquiSense — Canonical Environment Configuration (.env.example)
# Copy to `.env` for local development. NEVER commit real secrets to Git.
# =============================================================================

# --- 1. Execution Mode ("deterministic" works offline; "live" requires AICREDITS_API_KEY) ---
EXECUTION_MODE=deterministic
DETERMINISTIC_SCORING=true
ALLOW_DETERMINISTIC_FALLBACK=false
LLM_CACHE_ENABLED=true

# --- 2. AICredits GPT-4o Gateway Configuration (Required ONLY when EXECUTION_MODE=live) ---
AICREDITS_API_KEY=your_aicredits_api_key_here
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_MODEL=openai/gpt-4o
LLM_TEMPERATURE=0.0
LLM_TOP_P=1.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
CREWAI_TRACING_ENABLED=false
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true

# --- 3. Security & Service-to-Service Authentication Secrets ---
ACQUISENSE_JWT_SECRET=replace_with_64_hex_char_random_secret
ACQUISENSE_A2A_SECRET=replace_with_64_hex_char_random_secret

# --- 4. Durable Database Configuration ---
# Local development default: sqlite:////tmp/acquisense_prod_runtime/acquisense_durable_state.db
# Production multi-instance Cloud Run: postgresql+psycopg2://user:pass@/acquisense?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=sqlite:////tmp/acquisense_prod_runtime/acquisense_durable_state.db

# --- 5. Opt-In Cloud Deployment Configuration (Defaults to local-only operation) ---
DEPLOY_TARGET=none
CONFIRM_CLOUD_DEPLOY=false
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ARTIFACT_REPOSITORY=acquisense-repo
